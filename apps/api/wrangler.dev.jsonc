{
  // Local development (npm run dev:api). D1, R2 and Durable Objects run locally in .wrangler/state.
  // Workers AI has no local emulator: the "ai" binding talks to YOUR Cloudflare account (run `npx wrangler login` once;
  // calls use your Workers AI allocation). Without a login use `npm run dev:api:offline`, which starts the same API
  // without the AI binding — everything except AMIN AI's answers works and the app says plainly that AI is not connected.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "amin-chat-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "d1_databases": [{ "binding": "DB", "database_name": "amin-chat-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "amin-chat-files" }],
  "durable_objects": {
    "bindings": [
      { "name": "USER_HUB", "class_name": "UserHub" },
      { "name": "RUN_COORDINATOR", "class_name": "RunCoordinator" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserHub", "RunCoordinator", "RateLimiter"] }],
  "vars": {
    "ENVIRONMENT": "development",
    // In development the user named "dev_admin" is the administrator (register it in the app to see the admin tools).
    // ("admin", "root", "aminai" … are reserved names nobody can register.)
    "ADMIN_USERNAMES": "dev_admin",
    "ALLOWED_ORIGINS": ""
  }
}
