{
  "name": "@aminchat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.jsonc --ip 0.0.0.0 --port 8787",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply amin-chat-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply amin-chat-db --remote",
    "types": "wrangler types"
  },
  "dependencies": {
    "@aminchat/shared": "*",
    "fflate": "^0.8.2",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "5.20261115.1",
    "typescript": "7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "4.162.0"
  }
}
