# Build-time settings for the web app (copy to .env.local, or set them in the build environment). All optional.
# These are baked into the JavaScript at build time — they are PUBLIC. Never put a secret here.

# Where the Android app (or a web build hosted somewhere else) finds the API when the user has not typed an address yet.
# Leave empty for the normal web deployment, where the app and the API share one origin.
VITE_API_BASE=

# Addresses that ship inside this build, comma or space separated: relays/mirrors you run (see relay/ and docs/connectivity.md).
# A first launch whose main address is blocked fails over to these before it has ever reached the server.
# Example: VITE_API_BASES=https://relay1.example.com https://chat-mirror.example.net
VITE_API_BASES=
