# Copy to .env (docker compose) or /etc/amin-relay.env (systemd). Everything but UPSTREAM is optional.

# The address of your AMIN CHAT Worker — just the origin, no path.
UPSTREAM=https://amin-chat.your-subdomain.workers.dev

# Makes the Worker believe the client addresses this relay reports, so its per-address rate limits apply to people instead of to
# the relay. Use the SAME value as the Worker's secret:  wrangler secret put RELAY_SECRET   (generate one: openssl rand -hex 24)
RELAY_SECRET=

# Set to 1 when nginx / Caddy / a load balancer that YOU run sits in front of the relay and sets X-Forwarded-For.
TRUST_PROXY=0

PORT=8080
HOST=0.0.0.0

# Serve HTTPS directly (instead of putting nginx / Caddy in front). Both files, PEM format.
# TLS_CERT_FILE=/etc/letsencrypt/live/relay.example.com/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/relay.example.com/privkey.pem

# Advanced (defaults shown)
# MAX_BODY_MB=64
# CONNECT_TIMEOUT_MS=10000
# UPSTREAM_IDLE_TIMEOUT_MS=120000
# WS_LINGER_MS=10000
# REWRITE_WS_ORIGIN=1
# LOG=1
