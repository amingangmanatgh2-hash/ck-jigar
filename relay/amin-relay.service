# systemd unit for the relay.
#   sudo install -D relay.mjs /opt/amin-relay/relay.mjs
#   sudo install -m 600 .env.example /etc/amin-relay.env      # then edit it
#   sudo cp amin-relay.service /etc/systemd/system/ && sudo systemctl enable --now amin-relay
# Not run in the environment this was written in — check it with `systemd-analyze verify` on your server.
[Unit]
Description=AMIN CHAT relay
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/node /opt/amin-relay/relay.mjs
EnvironmentFile=/etc/amin-relay.env
DynamicUser=yes
Restart=always
RestartSec=2
# Hardening: the relay needs the network and nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
# Only if the relay serves TLS itself on port 443 (TLS_CERT_FILE) instead of sitting behind nginx / Caddy:
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# ReadOnlyPaths=/etc/letsencrypt

[Install]
WantedBy=multi-user.target
